NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy alternative:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional. Public site URL used in supplier share links (defaults to https://sourcing.nexo.ge).
# NEXT_PUBLIC_SITE_URL=https://sourcing.nexo.ge

# Optional. Secret used to encrypt saved supplier share links. If unset, a key is derived from
# SUPABASE_SERVICE_ROLE_KEY. Changing it makes already-saved links unreadable.
# SHARE_LINK_ENCRYPTION_KEY=

# Supplier portal only. Server-side secret; NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
